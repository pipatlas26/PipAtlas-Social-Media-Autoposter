//@version=5
//  PipAtlas strategy template (Pine v5) — https://pipatlas.com/learn/conversions
//  A skeleton with the four things every strategy needs before it means anything:
//  a rule for entry, a rule for exit, a stop that is defined before the trade, and a
//  position size derived from risk — not from conviction. Replace the placeholder
//  condition with your own idea and change nothing else until it is tested.
//  Education only, never financial advice. MIT licensed.
strategy("PipAtlas Strategy Template", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_order, commission_value = 0.35,
     slippage = 2, calc_on_every_tick = false)

riskPct   = input.float(1.0,  "Risk per trade (% of equity)", step = 0.25)
atrMult   = input.float(2.0,  "Stop = ATR x", step = 0.25)
rewardMult= input.float(2.0,  "Target = stop x", step = 0.25)
fastLen   = input.int(20,    "Fast average")
slowLen   = input.int(50,    "Slow average")

// ---- the idea (replace this block) -------------------------------------------
fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
longIdea  = ta.crossover(fast, slow)
shortIdea = ta.crossunder(fast, slow)
// ------------------------------------------------------------------------------

atr     = ta.atr(14)
stopDist = atr * atrMult
longStop  = close - stopDist
shortStop = close + stopDist
longTgt   = close + stopDist * rewardMult
shortTgt  = close - stopDist * rewardMult

// size from the distance to the stop, so a wider stop is a smaller position
riskCash  = strategy.equity * riskPct / 100
qtyLong   = stopDist > 0 ? riskCash / stopDist : 0
qtyShort  = qtyLong

if longIdea and strategy.position_size == 0
    strategy.entry("Long",  strategy.long,  qty = qtyLong)
    strategy.exit("Long exit",  from_entry = "Long",  stop = longStop,  limit = longTgt)
if shortIdea and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = qtyShort)
    strategy.exit("Short exit", from_entry = "Short", stop = shortStop, limit = shortTgt)

plot(fast, "Fast", color = color.new(color.teal, 0))
plot(slow, "Slow", color = color.new(color.orange, 0))
plot(strategy.position_size, "Position size", display = display.data_window)

// the honest part: a backtest on one symbol and one timeframe is one sample.
// Costs, slippage and swap are assumptions — check them against your own broker's numbers.
