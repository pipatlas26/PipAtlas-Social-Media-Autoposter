//@version=5
// ─────────────────────────────────────────────────────────────
//  PipAtlas Dual MA Cross — Pine Script v5
//  Copyright 2026 PipAtlas · MIT License · https://pipatlas.com
//  HOW TO USE: TradingView → Pine Editor → paste → "Add to chart".
//  Alerts: create alert → condition = this script → pick a cross event.
//  EDUCATION ONLY — not a trading signal.
// ─────────────────────────────────────────────────────────────
indicator("PipAtlas Dual MA Cross", shorttitle="PA Dual MA", overlay=true)

fastLen = input.int(20,  "Fast MA length", minval=1)
slowLen = input.int(50,  "Slow MA length", minval=2)
src     = input.source(close, "Source")
maType  = input.string("EMA", "MA type", options=["EMA", "SMA"])

fastMA = maType == "EMA" ? ta.ema(src, fastLen) : ta.sma(src, fastLen)
slowMA = maType == "EMA" ? ta.ema(src, slowLen) : ta.sma(src, slowLen)

plot(fastMA, "Fast MA", color=color.new(color.teal, 0),   linewidth=2)
plot(slowMA, "Slow MA", color=color.new(color.orange, 0), linewidth=2)

crossUp = ta.crossover(fastMA, slowMA)
crossDn = ta.crossunder(fastMA, slowMA)
plotshape(crossUp, style=shape.triangleup,   location=location.belowbar, color=color.teal,   size=size.tiny, title="Bull cross")
plotshape(crossDn, style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.tiny, title="Bear cross")

alertcondition(crossUp, "Fast crossed ABOVE slow", "PipAtlas: fast MA crossed above slow MA")
alertcondition(crossDn, "Fast crossed BELOW slow", "PipAtlas: fast MA crossed below slow MA")
